{
  "name": "songhub-songbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import/index.ts",
    "build:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import/build-data.ts",
    "qa": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "qa:full": "npm run qa && npm run build && npm run test:e2e",
    "measure:browser": "node scripts/measure-browser.mjs",
    "measure:perf": "PERF_SWEEP=1 playwright test performance --grep \"A-014 sweep\""
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
